generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  DOCUMENT
  IMAGE
}

model Asset {
  id            String    @id @default(uuid())
  filename      String
  type          AssetType @default(DOCUMENT)
  extractedText String?
  createdAt     DateTime  @default(now())
}
