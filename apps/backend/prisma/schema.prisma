generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AssetFormat {
  TEXT
  IMAGE
}

model Asset {
  id            String         @id @default(uuid())
  filename      String
  size          Int
  type          AssetFormat
  extractedText String?
  createdAt     DateTime       @default(now())
  metadata      AssetMetadata?
}

model AssetMetadata {
  assetId     String   @id
  description String
  keywords    String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

